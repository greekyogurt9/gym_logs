# Copy to .env.local and fill in. Never commit .env.local (public repo).
# Leave the Supabase vars EMPTY for V1 local-only mode (no login, no cloud).
# From V2 (accounts + cloud): set URL + ONE key. The publishable key
# (sb_publishable_...) is preferred; the legacy anon JWT also works.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
